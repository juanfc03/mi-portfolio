---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Juan Fernández Ceacero - Ingeniero Informático" } = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-material-symbols" />
    <title>{title}</title>
  </head>
  <body class="bg-surface text-on-surface antialiased selection:bg-primary selection:text-on-primary">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
