---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { SITIO } from '@/data/sitio';
import Cabecera from '@/components/Cabecera.astro';
import PiePagina from '@/components/PiePagina.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITIO.nombre} — ${SITIO.rol} | Desarrollo Web`,
  description = SITIO.descripcion,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITIO.nombre,
  url: SITIO.url,
  jobTitle: SITIO.rol,
  description: SITIO.descripcionCorta,
  inLanguage: 'es-ES',
  email: SITIO.correo,
  telephone: SITIO.telefono,
  knowsAbout: SITIO.knowsAbout,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: SITIO.universidad,
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Andalucía',
    addressCountry: 'ES',
  },
  sameAs: [SITIO.enlaceLinkedin, SITIO.enlaceGithub],
  image: `${SITIO.url}/open-graph/og-image.png`,
};
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Portfolio" />
    <link rel="canonical" href={urlCanonica} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={SITIO.nombre} />

    <!-- Open Graph (metaetiquetas sociales) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta
      property="og:image"
      content={`${SITIO.url}/open-graph/og-image.png`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITIO.nombre} />

    <!-- Twitter Card (metaetiquetas para Twitter / X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`${SITIO.url}/open-graph/og-image.png`}
    />

    <Font
      cssVariable="--font-jetbrains-mono"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <ClientRouter />
    <title>{title}</title>

    <!-- Datos estructurados (JSON-LD) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados).replace(/</g, '\\u003c')}
    />
  </head>
  <body
    class="bg-surface text-on-surface antialiased selection:bg-primary selection:text-on-primary"
  >
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:font-bold"
    >
      Saltar al contenido principal
    </a>
    <div
      id="notificacion"
      class="fixed top-4 right-4 z-100 flex items-center gap-3 px-6 py-4 opacity-0 pointer-events-none transition-all duration-300 ease-in-out translate-x-4"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <svg
        id="icono-notificacion"
        class="size-5"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></svg>
      <p
        id="mensaje-notificacion"
        class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg"
      >
      </p>
    </div>
    <Cabecera transition:persist="cabecera" />
    <main id="contenido-principal" class="pt-20">
      <slot />
    </main>
    <PiePagina transition:persist="pie-pagina" />
  </body>
</html>

<script>
  import { inicializarManifestPwa } from '@/scripts/manifest-pwa';
  import '@/scripts/rastreo-rutas';
  inicializarManifestPwa();
  document.addEventListener('astro:page-load', inicializarManifestPwa);
</script>
