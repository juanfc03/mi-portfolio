---
import Layout from '../layouts/Layout.astro';
import Cabecera from '../components/Cabecera.astro';
import Inicio from '../components/Inicio.astro';
import SobreMi from '../components/SobreMi.astro';
import Experiencia from '../components/Experiencia.astro';
import Proyectos from '../components/Proyectos.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Contacto from '../components/Contacto.astro';
import PiePagina from '../components/PiePagina.astro';
---

<Layout>
  <Cabecera />
  <main class="pt-20">
    <Inicio />
    <SobreMi />
    <Experiencia />
    <Proyectos />
    <Tecnologias />
    <Contacto />
  </main>
  <PiePagina />
</Layout>
