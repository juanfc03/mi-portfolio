---
import Layout from '@/layouts/Layout.astro';
import Cabecera from '@/components/Cabecera.astro';
import Inicio from '@/components/Inicio.astro';
import SobreMi from '@/components/SobreMi.astro';
import Experiencia from '@/components/Experiencia.astro';
import Proyectos from '@/components/Proyectos.astro';
import Tecnologias from '@/components/Tecnologias.astro';
import Contacto from '@/components/Contacto.astro';
import PiePagina from '@/components/PiePagina.astro';
---

<Layout>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:font-bold"
  >
    Saltar al contenido principal
  </a>
  <Cabecera />
  <main id="main-content" class="pt-20">
    <Inicio />
    <SobreMi />
    <Experiencia />
    <Proyectos />
    <Tecnologias />
    <Contacto />
  </main>
  <PiePagina />
</Layout>
