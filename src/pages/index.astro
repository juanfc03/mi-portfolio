---
import Layout from '@/layouts/Layout.astro';
import Inicio from '@/components/Inicio.astro';
import SobreMi from '@/components/SobreMi.astro';
import Experiencia from '@/components/Experiencia.astro';
import Proyectos from '@/components/Proyectos.astro';
import Tecnologias from '@/components/Tecnologias.astro';
import Contacto from '@/components/Contacto.astro';
---

<Layout>
  <Inicio />
  <SobreMi />
  <Experiencia />
  <Proyectos />
  <Tecnologias />
  <Contacto />
</Layout>

<script>
  import { inicializarRevelarScroll } from '@/scripts/revelar-scroll';
  inicializarRevelarScroll();
  document.addEventListener('astro:page-load', inicializarRevelarScroll);
</script>
