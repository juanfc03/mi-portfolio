---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  indice: number;
}

const { proyecto, indice } = Astro.props;
const { id, data } = proyecto;
const nombreTransicion = `proyecto-${id}`;
---

<article
  class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-gutter-xl items-start"
  data-indice={indice}
>
  <div
    class={`lg:col-span-7 order-2 ${data.imagenIzquierda ? 'lg:order-1' : 'lg:order-2'}`}
  >
    <a
      href={`/proyectos/${id}/`}
      aria-label={`Ver proyecto ${data.titulo}`}
      class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <figure
        class="aspect-4:3 bg-surface-variant border border-outline-variant w-full m-0 relative overflow-hidden group"
        transition:name={nombreTransicion}
      >
        <Image
          src={data.imagen}
          alt={data.imagenAlt}
          class="size-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out"
          loading={indice > 0 ? 'lazy' : 'eager'}
          decoding="async"
          format="webp"
          quality={75}
          widths={[400, 640, 832, 1088, data.imagen.width]}
          sizes="(max-width: 480px) 400px, (max-width: 768px) 640px, (max-width: 1024px) 832px, (max-width: 1280px) 1088px, 1088px"
        />
        <span
          class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"
        ></span>
      </figure>
    </a>
  </div>
  <div
    class={`lg:col-span-5 space-y-6 order-1 ${data.imagenIzquierda ? 'lg:order-2' : 'lg:order-1'}`}
  >
    <h3
      class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary"
      transition:name={`proyecto-${id}-titulo`}
    >
      <a href={`/proyectos/${id}/`} class="hover:opacity-70 transition-opacity">
        {data.titulo}
      </a>
    </h3>
    <p
      class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant"
    >
      {data.descripcion}
    </p>
    <ul
      class="flex flex-wrap gap-2 pt-2"
      transition:name={`proyecto-${id}-herramientas`}
    >
      {
        data.herramientas.map(herramienta => (
          <li class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase border border-outline-variant px-3 py-1">
            {herramienta}
          </li>
        ))
      }
    </ul>
    <div class="pt-2">
      <a
        class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-primary border-b border-primary pb-1 hover:opacity-70 transition-opacity inline-flex items-center gap-2"
        href={`/proyectos/${id}/`}
        aria-label={`Ver detalle de ${data.titulo}`}
      >
        Ver proyecto
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>
