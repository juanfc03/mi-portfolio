---
import { SITE } from '@/data/site';
---

<section
  class="py-section-y-xs sm:py-section-y-sm md:py-section-y-md lg:py-section-y-lg xl:py-section-y-xl px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl border-t border-outline-variant"
  id="contacto"
>
  <div
    class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-gutter-xs sm:gap-gutter-sm md:gap-gutter-md lg:gap-gutter-lg xl:gap-gutter-xl"
  >
    <header class="md:col-span-4">
      <h2
        class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary"
      >
        05. Contacto
      </h2>
    </header>
    <div class="md:col-span-8">
      <div class="mb-12">
        <p class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant mb-2">
          ¿Buscas un desarrollador web para tu equipo o necesitas una página web
          profesional? No dudes en contactar conmigo.
        </p>
        <address class="not-italic">
          <a
            class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary hover:opacity-70 transition-opacity block break-all underline underline-offset-4"
            href={`mailto:${SITE.email}`}>{SITE.email}</a
          >
          <div class="mt-4">
            <p class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant mb-2">
              O por WhatsApp:
            </p>
            <a
              class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary hover:opacity-70 transition-opacity block underline underline-offset-4"
              href={SITE.whatsappLink}>{SITE.phoneDisplay}</a
            >
          </div>
        </address>
      </div>
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-8 max-w-2xl"
        id="contact-form"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label
            >No rellenes esto si eres humano: <input name="bot-field" /></label
          >
        </p>
        <div class="relative">
          <label
            class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant block mb-2"
            for="name">Nombre</label
          >
          <input
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-primary transition-colors"
            id="name"
            name="nombre"
            placeholder="Tu nombre"
            type="text"
            autocomplete="given-name"
            required
          />
        </div>
        <div class="relative">
          <label
            class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant block mb-2"
            for="email">Email</label
          >
          <input
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-primary transition-colors"
            id="email"
            name="email"
            placeholder="tu@email.com"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="relative">
          <label
            class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant block mb-2"
            for="message">Mensaje</label
          >
          <textarea
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-primary transition-colors resize-none"
            id="message"
            name="mensaje"
            placeholder="¿En qué puedo ayudarte?"
            rows="4"
            required></textarea>
        </div>
        <button
          class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase bg-primary text-on-primary px-8 py-4 border border-primary hover:bg-surface hover:text-primary transition-colors w-full md:w-auto cursor-pointer"
          type="submit">Enviar mensaje</button
        >
      </form>
      <p class="font-caption text-caption-xs md:text-caption-md lg:text-caption-lg text-on-surface-variant mt-16">
        Gracias por visitar mi portfolio.
      </p>
    </div>
  </div>

  <!-- Toast notification -->
  <div
    id="toast"
    class="fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 opacity-0 pointer-events-none transition-all duration-300 ease-in-out translate-x-4"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <svg
      id="toast-icon"
      class="size-5"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></svg>
    <p id="toast-message" class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg"></p>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const toast = document.getElementById('toast') as HTMLDivElement;
  const toastIcon = document.getElementById(
    'toast-icon',
  ) as unknown as SVGSVGElement;
  const toastMessage = document.getElementById(
    'toast-message',
  ) as HTMLParagraphElement;

  const iconPaths: Record<string, string> = {
    success: '<polyline points="20 6 9 17 4 12"></polyline>',
    error:
      '<circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line>',
  };

  function showToast(type: 'success' | 'error', message: string) {
    toastIcon.innerHTML = iconPaths[type];
    toastIcon.setAttribute('aria-hidden', 'true');
    toastMessage.textContent = message;

    toast.className = `fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 transition-all duration-300 ease-in-out ${
      type === 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white'
    } opacity-100 translate-x-0 pointer-events-auto`;

    toast.setAttribute('role', type === 'error' ? 'alert' : 'status');

    setTimeout(() => {
      toast.className =
        'fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 transition-all duration-300 ease-in-out opacity-0 translate-x-4 pointer-events-none';
    }, 4000);
  }

  form?.addEventListener('submit', async e => {
    e.preventDefault();

    const formData = new FormData(form);
    const body = new URLSearchParams(
      Array.from(formData, ([key, value]) => [key, String(value)]),
    ).toString();

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });

      if (response.ok) {
        showToast('success', '¡Mensaje enviado correctamente!');
        form.reset();
      } else {
        showToast('error', 'Error al enviar el mensaje. Inténtalo de nuevo.');
      }
    } catch {
      showToast('error', 'Error de conexión. Inténtalo de nuevo.');
    }
  });
</script>
