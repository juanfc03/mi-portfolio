<section
  class="py-24 md:py-32 px-margin-mobile md:px-margin-desktop border-t border-outline-variant"
  id="contacto"
>
  <div
    class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-gutter"
  >
    <div class="md:col-span-4">
      <h2
        class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary"
      >
        05. Contacto
      </h2>
    </div>
    <div class="md:col-span-8">
      <div class="mb-12">
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-2">
          ¿Buscas un desarrollador web para tu equipo o necesitas una página web
          profesional? No dudes en contactar conmigo.
        </p>
        <a
          class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary hover:opacity-70 transition-opacity block break-all underline underline-offset-4"
          href="mailto:juanf.ceacero@gmail.com">juanf.ceacero@gmail.com</a
        >
        <div class="mt-4">
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-2">
            O por WhatsApp:
          </p>
          <a
            class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary hover:opacity-70 transition-opacity block underline underline-offset-4"
            href="https://wa.me/34622384951?text=%C2%A1Hola%20Juan!"
            >622384951</a
          >
        </div>
      </div>
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-8 max-w-2xl"
        id="contact-form"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label
            >No rellenes esto si eres humano: <input name="bot-field" /></label
          >
        </p>
        <div class="relative">
          <label
            class="font-label-md text-label-md uppercase text-on-surface-variant block mb-2"
            for="name">Nombre</label
          >
          <input
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-lg text-body-lg text-primary transition-colors"
            id="name"
            name="nombre"
            placeholder="Tu nombre"
            type="text"
            autocomplete="given-name"
            required
          />
        </div>
        <div class="relative">
          <label
            class="font-label-md text-label-md uppercase text-on-surface-variant block mb-2"
            for="email">Email</label
          >
          <input
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-lg text-body-lg text-primary transition-colors"
            id="email"
            name="email"
            placeholder="tu@email.com"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="relative">
          <label
            class="font-label-md text-label-md uppercase text-on-surface-variant block mb-2"
            for="message">Mensaje</label
          >
          <textarea
            class="w-full bg-transparent border-0 border-b border-outline-variant focus:border-primary focus:ring-0 px-2 py-3 font-body-lg text-body-lg text-primary transition-colors resize-none"
            id="message"
            name="mensaje"
            placeholder="¿En qué puedo ayudarte?"
            rows="4"
            required></textarea>
        </div>
        <button
          class="font-label-md text-label-md uppercase bg-primary text-on-primary px-8 py-4 border border-primary hover:bg-surface hover:text-primary transition-colors w-full md:w-auto cursor-pointer"
          type="submit">Enviar mensaje</button
        >
      </form>
      <p class="font-body-md text-body-md text-on-surface-variant mt-16 italic">
        Gracias por visitar mi portfolio.
      </p>
    </div>
  </div>

  <!-- Toast notification -->
  <div
    id="toast"
    class="fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 shadow-lg opacity-0 pointer-events-none transition-all duration-300 ease-in-out translate-x-4"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <svg
      id="toast-icon"
      class="w-5 h-5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></svg>
    <p id="toast-message" class="font-body-md text-body-md"></p>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const toast = document.getElementById('toast') as HTMLDivElement;
  const toastIcon = document.getElementById(
    'toast-icon',
  ) as unknown as SVGSVGElement;
  const toastMessage = document.getElementById(
    'toast-message',
  ) as HTMLParagraphElement;

  const iconPaths: Record<string, string> = {
    success: '<polyline points="20 6 9 17 4 12"></polyline>',
    error:
      '<circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line>',
  };

  function showToast(type: 'success' | 'error', message: string) {
    toastIcon.innerHTML = iconPaths[type];
    toastMessage.textContent = message;

    toast.className = `fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 shadow-lg transition-all duration-300 ease-in-out ${
      type === 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white'
    } opacity-100 translate-x-0 pointer-events-auto`;

    setTimeout(() => {
      toast.className =
        'fixed top-24 right-4 z-50 flex items-center gap-3 px-6 py-4 shadow-lg transition-all duration-300 ease-in-out opacity-0 translate-x-4 pointer-events-none';
    }, 4000);
  }

  form?.addEventListener('submit', async e => {
    e.preventDefault();

    const formData = new FormData(form);

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString(),
      });

      if (response.ok) {
        showToast('success', '¡Mensaje enviado correctamente!');
        form.reset();
      } else {
        showToast('error', 'Error al enviar el mensaje. Inténtalo de nuevo.');
      }
    } catch {
      showToast('error', 'Error de conexión. Inténtalo de nuevo.');
    }
  });
</script>
