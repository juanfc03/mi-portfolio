---
import { SITIO } from '@/data/sitio';

const year = new Date().getFullYear();
---

<footer class="w-full py-16 bg-surface border-t border-outline-variant">
  <div
    class="flex flex-col md:flex-row justify-between items-center px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl max-w-container-max mx-auto gap-8"
  >
    <p
      class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant"
    >
      &copy; {year} {SITIO.nombre}. Hecho con precisión.
    </p>
    <nav aria-label="Anclas y redes sociales">
      <ul class="flex gap-6">
        <li>
          <a
            class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary underline transition-colors"
            href="/#contenido-principal">Inicio</a
          >
        </li>
        <li>
          <a
            class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary underline transition-colors"
            href={SITIO.enlaceLinkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn de Juan Fernández (se abre en nueva pestaña)"
            >LinkedIn</a
          >
        </li>
        <li>
          <a
            class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary underline transition-colors"
            href={SITIO.enlaceGithub}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub de Juan Fernández (se abre en nueva pestaña)"
            >GitHub</a
          >
        </li>
      </ul>
    </nav>
  </div>
</footer>
