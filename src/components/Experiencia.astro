---
interface Experiencia {
  empresa: string;
  puesto: string;
  fechaInicio: string;
  fechaFin: string;
  duracion: string;
  ubicacion?: string;
  descripcion: string;
}

const formatFecha = (iso: string) => {
  const [year, month] = iso.split('-').map(Number);
  return new Intl.DateTimeFormat('es-ES', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year, month - 1)));
};

const experiencias: Experiencia[] = [
  {
    empresa: 'Innovation Studio',
    puesto: 'Desarrollador de aplicaciones web',
    fechaInicio: '2025-10',
    fechaFin: '2025-12',
    duracion: '3 meses',
    ubicacion: 'Jaén, Andalucía, España · Híbrido',
    descripcion:
      'Colaboración en el desarrollo y mantenimiento de páginas web utilizando PHP y Laravel. Participación en el ciclo completo de desarrollo, incluyendo diseño de funcionalidades, implementación y pruebas. Migración de proyectos antiguos a las últimas versiones de Laravel.',
  },
];
---

<section
  class="py-section-y-xs sm:py-section-y-sm md:py-section-y-md lg:py-section-y-lg xl:py-section-y-xl px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl border-t border-outline-variant bg-surface-bright"
  id="experiencia"
>
  <div
    class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-gutter-xs sm:gap-gutter-sm md:gap-gutter-md lg:gap-gutter-lg xl:gap-gutter-xl"
  >
    <header class="md:col-span-4">
      <h2
        class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary sticky top-32"
      >
        02. Experiencia
      </h2>
    </header>
    <div class="md:col-span-8">
      <div class="space-y-16">
        {
          experiencias.map(exp => (
            <article class="border-t border-outline-variant pt-8">
              <header class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-4 gap-2">
                <div>
                  <h3 class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary">
                    {exp.empresa}
                  </h3>
                  <p class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant mt-1">
                    {exp.puesto}
                  </p>
                </div>
                <div class="text-right">
                  <span class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant block">
                    <time datetime={exp.fechaInicio}>{formatFecha(exp.fechaInicio)}</time> — <time datetime={exp.fechaFin}>{formatFecha(exp.fechaFin)}</time> · {exp.duracion}
                  </span>
                  {exp.ubicacion && (
                    <address class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant mt-1 block not-italic">
                      {exp.ubicacion}
                    </address>
                  )}
                </div>
              </header>
              <p class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant">
                {exp.descripcion}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
