---
import { Image } from "astro:assets";
import retratoMio from "../assets/retrato_mio.png";
---

<section
  class="min-h-[calc(100vh-80px)] flex flex-col md:flex-row items-center justify-between px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto gap-12 py-20"
>
  <div class="flex-1 space-y-8">
    <div>
      <h1 class="font-display-lg text-display-lg text-primary mb-4">
        Juan Fernández Ceacero
      </h1>
      <p
        class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface-variant"
      >
        Ingeniero informático
      </p>
    </div>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
      Ingeniero informático recién graduado. Construyo aplicaciones web modernas con foco en la calidad del código.
    </p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a
        class="font-label-md text-label-md uppercase bg-primary text-on-primary px-8 py-4 border border-primary hover:bg-surface hover:text-primary transition-colors"
        href="#proyectos">Ver proyectos</a
      >
      <a
        class="font-label-md text-label-md uppercase bg-transparent text-primary px-8 py-4 border border-primary hover:bg-primary hover:text-on-primary transition-colors"
        href="#contacto">Contactar</a
      >
    </div>
  </div>
  <div class="flex-1 w-full max-w-md aspect-3/4 relative">
    <div
      class="absolute inset-0 bg-surface-variant border border-outline-variant overflow-hidden"
    >
      <Image
        src={retratoMio}
        alt="Juan Fernández Ceacero Portrait"
        class="w-full h-full object-cover grayscale mix-blend-multiply"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={75}
        widths={[400, 700]}
        sizes="(max-width: 768px) 400px, 700px"
      />
    </div>
  </div>
</section>
