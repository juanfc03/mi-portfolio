---
import { Image } from 'astro:assets';
import retratoMio from '../assets/retrato-mio.png';
---

<section
  class="min-h-[calc(100vh-80px)] flex flex-col md:flex-row items-center justify-between px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl max-w-container-max mx-auto gap-12 py-section-y-xs sm:py-section-y-sm md:py-section-y-md lg:py-section-y-lg xl:py-section-y-xl"
>
  <div class="flex-1 space-y-8">
    <header>
      <h1 class="font-display-lg text-display-xs sm:text-display-sm md:text-display-md text-primary mb-4">
        Juan Fernández Ceacero
      </h1>
      <p
        class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-on-surface-variant"
      >
        Ingeniero informático
      </p>
    </header>
    <p class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant max-w-xl">
      Ingeniero informático recién graduado. Construyo aplicaciones web modernas
      con foco en la calidad del código.
    </p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a
        class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase bg-primary text-on-primary px-8 py-4 border border-primary hover:bg-surface hover:text-primary transition-colors"
        href="#proyectos">Ver proyectos</a
      >
      <a
        class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase bg-transparent text-primary px-8 py-4 border border-primary hover:bg-primary hover:text-on-primary transition-colors"
        href="#contacto">Contactar</a
      >
    </div>
  </div>
  <figure class="flex-1 w-full max-w-md aspect-3/4 m-0 relative">
    <div
      class="absolute inset-0 bg-surface-variant border border-outline-variant overflow-hidden"
    >
      <Image
        src={retratoMio}
        alt="Retrato de Juan Fernández Ceacero, ingeniero informático"
        class="size-full object-cover grayscale mix-blend-multiply"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        format="webp"
        quality={75}
        widths={[retratoMio.width]}
        sizes={`${retratoMio.width}px`}
      />
    </div>
  </figure>
</section>
