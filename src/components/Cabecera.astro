          href="#sobre-mi">Sobre mí</a
        >
      </li>
      <li>
        <a
          class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors py-2 border-b border-outline-variant"
          href="#experiencia">Experiencia</a
