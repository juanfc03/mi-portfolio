<style>
  /* Oculta la navegación de escritorio en móvil como defensa en profundidad (la clase `hidden` ya debería hacerlo). */
  @media (max-width: 767px) {
    .nav-escritorio {
      display: none !important;
    }
  }

  /* Oculta el menú móvil en escritorio (anula el `display: block` por defecto en pantallas pequeñas). */
  @media (min-width: 768px) {
    .menu-movil {
      display: none !important;
    }
  }

  .menu-movil {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease-in-out;
  }
  .menu-movil[data-abierto='true'] {
    max-height: 600px;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-movil {
      transition: none;
    }
  }
</style>

<script>
  // Control del menú móvil: alterna visibilidad, iconos, atributos ARIA
  // y cierra al pulsar un enlace o la tecla Escape.
  const botonAlternar = document.getElementById('alternar-menu');
  const menu = document.getElementById('menu-movil');
  const iconoMenu = document.getElementById('icono-menu');
  const iconoCerrar = document.getElementById('icono-cerrar');

  function establecerMenu(abierto: boolean, enfocarPrimerEnlace = false) {
    if (!botonAlternar || !menu || !iconoMenu || !iconoCerrar) return;
    menu.dataset.abierto = abierto ? 'true' : 'false';
    menu.inert = !abierto;
    iconoMenu.classList.toggle('hidden', abierto);
    iconoCerrar.classList.toggle('hidden', !abierto);
    botonAlternar.setAttribute('aria-expanded', abierto ? 'true' : 'false');

    if (abierto && enfocarPrimerEnlace) {
      const primerEnlace = menu.querySelector<HTMLAnchorElement>('a');
      primerEnlace?.focus();
    }
  }

  botonAlternar?.addEventListener('click', () => {
    const seAbrira = menu?.dataset.abierto !== 'true';
    establecerMenu(seAbrira, seAbrira);
  });

  menu?.querySelectorAll('a').forEach(enlace => {
    enlace.addEventListener('click', () => establecerMenu(false));
  });

  document.addEventListener('keydown', evento => {
    if (evento.key === 'Escape' && menu?.dataset.abierto === 'true') {
      establecerMenu(false);
      botonAlternar?.focus();
    }
  });
</script>
