  >
    <ul class="nav-desktop hidden md:flex items-center gap-8">
      <li>
        <a
          class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors"
          href="#sobre-mi">Sobre mí</a
        >
      </li>
      <li>
        <a
          class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors"
          href="#experiencia">Experiencia</a
        >
      </li>
      <li>
        <a
          class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors"
          href="#proyectos">Proyectos</a
        >
      </li>
      <li>
