---
const SECCIONES_NAV = [
  { label: 'Sobre mí', href: '/#sobre-mi' },
  { label: 'Experiencia', href: '/#experiencia' },
  { label: 'Proyectos', href: '/#proyectos' },
  { label: 'Tecnologías', href: '/#tecnologias' },
];

const claseEnlace =
  'font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors';
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-sm border-b border-outline-variant transition-colors duration-300 ease-in-out"
>
  <div
    class="flex justify-between items-center h-20 px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl max-w-container-max mx-auto"
  >
    <ul class="nav-escritorio hidden md:flex items-center gap-8">
      {SECCIONES_NAV.map(({ label, href }) => (
        <li>
          <a class={claseEnlace} href={href}>{label}</a>
        </li>
      ))}
    </ul>
    <a
      class="hidden md:inline-flex font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase bg-primary text-on-primary px-6 py-3 hover:bg-surface hover:text-primary border border-primary transition-colors"
      href="/#contacto">Contáctame</a
    >
    <!-- Botón del menú móvil -->
    <button
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="menu-movil"
      class="md:hidden text-primary size-10 flex items-center justify-center"
      id="alternar-menu"
    >
      <svg
        id="icono-menu"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        id="icono-cerrar"
        class="hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <!-- Menú móvil (transición de max-height) -->
  <div class="menu-movil md:hidden" id="menu-movil" data-abierto="false" inert>
    <ul
      class="px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl pb-6 flex flex-col gap-4"
    >
      {SECCIONES_NAV.map(({ label, href }) => (
        <li class="border-b border-outline-variant">
          <a class={`${claseEnlace} pb-2 block`} href={href}>{label}</a>
        </li>
      ))}
      <li class="mt-2">
        <a
          class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase bg-primary text-on-primary px-6 py-3 text-center hover:bg-surface hover:text-primary border border-primary transition-colors block w-full"
          href="/#contacto">Contáctame</a
        >
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Oculta la navegación de escritorio en móvil como defensa en profundidad (la clase `hidden` ya debería hacerlo). */
  @media (max-width: 767px) {
    .nav-escritorio {
      display: none !important;
    }
  }

  /* Oculta el menú móvil en escritorio (anula el `display: block` por defecto en pantallas pequeñas). */
  @media (min-width: 768px) {
    .menu-movil {
      display: none !important;
    }
  }

  .menu-movil {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease-in-out;
  }
  .menu-movil[data-abierto='true'] {
    max-height: 600px;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-movil {
      transition: none;
    }
  }
</style>

<script>
  import { inicializarMenuMovil } from '@/scripts/menu-movil';
  inicializarMenuMovil();
  document.addEventListener('astro:page-load', inicializarMenuMovil);
  document.addEventListener('astro:after-swap', inicializarMenuMovil);
</script>
