---
interface CategoriaTecnologia {
  nombre: string;
  tecnologias: string[];
}

const categorias: CategoriaTecnologia[] = [
  {
    nombre: 'Lenguajes',
    tecnologias: ['PHP', 'Java', 'JavaScript / TypeScript'],
  },
  {
    nombre: 'Backend',
    tecnologias: ['Laravel', 'Livewire', 'Spring Boot', 'PostgreSQL', 'MySQL'],
  },
  {
    nombre: 'Frontend',
    tecnologias: ['Astro', 'Tailwind CSS', 'Livewire'],
  },
  {
    nombre: 'Herramientas',
    tecnologias: ['Git', 'Agentes de IA'],
  },
];
---

<section
  class="py-section-y-xs sm:py-section-y-sm md:py-section-y-md lg:py-section-y-lg xl:py-section-y-xl px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl border-t border-outline-variant bg-surface-bright"
  id="tecnologias"
>
  <div
    class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-gutter-xs sm:gap-gutter-sm md:gap-gutter-md lg:gap-gutter-lg xl:gap-gutter-xl"
  >
    <div class="md:col-span-4">
      <h2
        class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary sticky top-32"
      >
        04. Tecnologías
      </h2>
    </div>
    <div class="md:col-span-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-12 gap-x-8">
        {
          categorias.map(categoria => (
            <div>
              <h3 class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant mb-4">
                {categoria.nombre}
              </h3>
              <ul class="space-y-2 font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-primary">
                {categoria.tecnologias.map(tech => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
