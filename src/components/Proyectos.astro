---
import { Image } from 'astro:assets';
import { SITIO } from '@/data/sitio';
import proyectoTfg from '../assets/proyecto-tfg.png';
import proyectoRosa from '../assets/proyecto-rosa.png';
import proyectoKardia from '../assets/proyecto-kardia.png';

interface Proyecto {
  titulo: string;
  descripcion: string;
  herramientas: string[];
  demoUrl: string;
  repositorioUrl: string;
  imagen: ImageMetadata;
  imagenAlt: string;
  imagenIzquierda: boolean;
}

const proyectos: Proyecto[] = [
  {
    titulo: 'Trabajo de fin de grado',
    descripcion:
      'Desarrollo de una página web de venta de coches con un asistente basado en IA integrado. El proyecto sigue una metodología de software rigurosa y aplica las últimas tecnologías del sector, incluyendo pasarela de pago con Stripe.',
    herramientas: ['Laravel', 'Livewire', 'Tailwind CSS', 'Stripe API'],
    demoUrl: 'https://trabajo-fin-de-grado-jfc00031.free.laravel.cloud/',
    repositorioUrl: `${SITIO.enlaceGithub}/trabajo-fin-de-grado-carai`,
    imagen: proyectoTfg,
    imagenAlt: 'Plataforma de venta de coches con asistente IA',
    imagenIzquierda: true,
  },
  {
    titulo: 'Landing page para una psicóloga',
    descripcion:
      'Desarrollo de una página web profesional para una psicóloga, con diseño responsive, secciones de servicios, testimonios y sistema de contacto. Optimizada para SEO y rendimiento.',
    herramientas: ['Astro', 'Tailwind CSS'],
    demoUrl: 'https://rosamruizpsicologa.es/',
    repositorioUrl: `${SITIO.enlaceGithub}/rosamr-web-psicologia`,
    imagen: proyectoRosa,
    imagenAlt: 'Página web de psicóloga profesional',
    imagenIzquierda: false,
  },
  {
    titulo: 'Landing page para un centro de formación',
    descripcion:
      'Página web moderna y de alto rendimiento enfocada en la velocidad de carga, accesibilidad y la gestión de formularios con Netlify Forms.',
    herramientas: ['Astro', 'Tailwind CSS', 'Netlify Forms'],
    demoUrl: 'https://kardiaformacion.es/',
    repositorioUrl: `${SITIO.enlaceGithub}/maysu-web-formacion`,
    imagen: proyectoKardia,
    imagenAlt: 'Landing page de centro de formación profesional',
    imagenIzquierda: true,
  },
];
---

<section
  class="py-section-y-xs sm:py-section-y-sm md:py-section-y-md lg:py-section-y-lg xl:py-section-y-xl px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl border-t border-outline-variant"
  id="proyectos"
>
  <div class="max-w-container-max mx-auto">
    <header class="mb-16 md:mb-24">
      <h2
        class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary"
      >
        03. Proyectos
      </h2>
    </header>
    <div class="space-y-32">
      {
        proyectos.map(proyecto => (
           <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-gutter-xl items-center">
           <div
              class={`lg:col-span-7 order-2 ${proyecto.imagenIzquierda ? 'lg:order-1' : 'lg:order-2'}`}
            >
              <figure class="aspect-video bg-surface-variant border border-outline-variant w-full m-0 relative overflow-hidden group">
                <Image
                  src={proyecto.imagen}
                  alt={proyecto.imagenAlt}
                   class="size-full object-cover grayscale group-hover:grayscale-0 transition-[filter] duration-700"
                 loading="lazy"
                  decoding="async"
                  format="webp"
                  quality={75}
                   widths={[proyecto.imagen.width]}
                  sizes={`${proyecto.imagen.width}px`}
               />
              </figure>
            </div>
            <div
              class={`lg:col-span-5 space-y-6 order-1 ${proyecto.imagenIzquierda ? 'lg:order-2' : 'lg:order-1'}`}
            >
              <h3 class="font-headline-lg text-headline-xs sm:text-headline-sm md:text-headline-md text-primary">
                {proyecto.titulo}
              </h3>
              <p class="font-body-large text-body-large-xs sm:text-body-large-sm md:text-body-large-md lg:text-body-large-lg xl:text-body-large-xl text-on-surface-variant">
                {proyecto.descripcion}
              </p>
              <ul class="flex flex-wrap gap-2 pt-2">
                {proyecto.herramientas.map(herramienta => (
                  <li class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase border border-outline-variant px-3 py-1">
                    {herramienta}
                  </li>
                ))}
              </ul>
              <div class="flex gap-6 pt-6">
                <a
                  class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-primary border-b border-primary pb-1 hover:opacity-70 transition-opacity"
                  href={proyecto.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver demo de ${proyecto.titulo} (se abre en nueva pestaña)`}
                >
                  Ver demo
                </a>
                <a
                  class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant border-b border-on-surface-variant pb-1 hover:text-primary hover:border-primary transition-colors"
                  href={proyecto.repositorioUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver repositorio de ${proyecto.titulo} (se abre en nueva pestaña)`}
                >
                  Repositorio
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
