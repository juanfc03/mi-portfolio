---
import { Picture } from "astro:assets";
import proyectoTfg from "../assets/proyecto-tfg.png";
import proyectoRosa from "../assets/proyecto-rosa.png";

interface Proyecto {
  titulo: string;
  descripcion: string;
  herramientas: string[];
  demoUrl: string;
  repositorioUrl: string;
  imagen: ImageMetadata;
  imagenAlt: string;
  imagenIzquierda: boolean;
}

const proyectos: Proyecto[] = [
  {
    titulo: "Trabajo de fin de grado",
    descripcion:
      "Desarrollo de una página web de venta de coches con un asistente basado en IA integrado. El proyecto sigue una metodología de software rigurosa y aplica las últimas tecnologías del sector, incluyendo pasarela de pago con Stripe.",
    herramientas: ["Laravel", "Livewire", "Tailwind CSS", "Stripe API"],
    demoUrl: "#",
    repositorioUrl: "#",
    imagen: proyectoTfg,
    imagenAlt: "Plataforma de venta de coches con asistente IA",
    imagenIzquierda: true,
  },
  {
    titulo: "Landing page para una psicóloga",
    descripcion:
      "Desarrollo de una página web profesional para una psicóloga, con diseño responsive, secciones de servicios, testimonios y sistema de contacto. Optimizada para SEO y rendimiento.",
    herramientas: ["Astro", "Tailwind CSS"],
    demoUrl: "#",
    repositorioUrl: "#",
    imagen: proyectoRosa,
    imagenAlt: "Página web de psicóloga profesional",
    imagenIzquierda: false,
  },
];
---

<section
  class="py-24 md:py-32 px-margin-mobile md:px-margin-desktop border-t border-outline-variant"
  id="proyectos"
>
  <div class="max-w-container-max mx-auto">
    <h2
      class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-16 md:mb-24"
    >
      03. Proyectos
    </h2>
    <div class="space-y-32">
      {
        proyectos.map(proyecto => (
          <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-gutter items-center">
            <div
              class={`lg:col-span-7 order-2 ${proyecto.imagenIzquierda ? "lg:order-1" : "lg:order-2"}`}
            >
              <div class="aspect-video bg-surface-variant border border-outline-variant w-full relative overflow-hidden group">
                <Picture
                  src={proyecto.imagen}
                  alt={proyecto.imagenAlt}
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                  loading="lazy"
                  format="webp"
                  quality={75}
                  widths={[400, 800]}
                  sizes="(max-width: 768px) 400px, 800px"
                />
              </div>
            </div>
            <div
              class={`lg:col-span-5 space-y-6 order-1 ${proyecto.imagenIzquierda ? "lg:order-2" : "lg:order-1"}`}
            >
              <h3 class="font-display-lg text-headline-lg-mobile md:text-display-lg text-primary">
                {proyecto.titulo}
              </h3>
              <p class="font-body-lg text-body-lg text-on-surface-variant">
                {proyecto.descripcion}
              </p>
              <div class="flex flex-wrap gap-2 pt-2">
                {proyecto.herramientas.map(herramienta => (
                  <span class="font-label-md text-label-md uppercase border border-outline-variant px-3 py-1">
                    {herramienta}
                  </span>
                ))}
              </div>
              <div class="flex gap-6 pt-6">
                <a
                  class="font-label-md text-label-md uppercase text-primary border-b border-primary pb-1 hover:opacity-70 transition-opacity"
                  href={proyecto.demoUrl}
                >
                  Ver demo
                </a>
                <a
                  class="font-label-md text-label-md uppercase text-on-surface-variant border-b border-on-surface-variant pb-1 hover:text-primary hover:border-primary transition-all"
                  href={proyecto.repositorioUrl}
                >
                  Repositorio
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
