---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import '@/styles/proyecto-detalle.css';

import type { MarkdownHeading } from 'astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  Content: AstroComponentFactory;
  headings: MarkdownHeading[];
}

const { proyecto, Content, headings } = Astro.props;
const { id, data } = proyecto;
const nombreTransicion = `proyecto-${id}`;
---

<article>
  <div
    class="px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl border-b border-outline-variant"
  >
    <div
      class="max-w-container-max mx-auto py-section-y-sm sm:py-section-y-md md:py-section-y-md grid grid-cols-1 md:grid-cols-12 gap-gutter-md lg:gap-gutter-xl items-start"
    >
      <div class="md:col-span-7 order-1 relative">
        <button
          type="button"
          id="volver-detalle"
          class="inline-flex items-center gap-2 font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant hover:text-primary transition-colors mb-4 cursor-pointer"
          aria-label="Volver a la posición anterior"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver
        </button>
        <figure class="m-0">
          <div
            class="aspect-4/3 bg-surface-variant border border-outline-variant overflow-hidden"
            transition:name={nombreTransicion}
          >
            <Image
              src={data.imagen}
              alt={data.imagenAlt}
              class="size-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              format="webp"
              quality={75}
              widths={[400, 640, 832, 1088, data.imagen.width]}
              sizes="(max-width: 480px) 400px, (max-width: 768px) 640px, (max-width: 1024px) 832px, 768px"
            />
          </div>
        </figure>
      </div>

      <div class="md:col-span-5 order-2 space-y-8 md:pt-6">
        <h1
          class="font-headline-lg text-headline-sm sm:text-headline-md md:text-headline-lg text-primary"
          transition:name={`proyecto-${id}-titulo`}
        >
          {data.titulo}
        </h1>
        <div class="space-y-3">
          <p
            class="detalle-reveal font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant"
            style="--detalle-reveal-delay: 240ms"
          >
            Stack
          </p>
          <ul
            class="flex flex-wrap gap-2"
            transition:name={`proyecto-${id}-herramientas`}
          >
            {
              data.herramientas.map(herramienta => (
                <li class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase border border-outline-variant px-3 py-1">
                  {herramienta}
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class="detalle-reveal flex flex-wrap gap-x-6 gap-y-3"
          style="--detalle-reveal-delay: 360ms"
        >
          {
            data.demoUrl && (
              <a
                class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-primary border-b border-primary pb-1 hover:opacity-70 transition-opacity"
                href={data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver demo de ${data.titulo} (se abre en nueva pestaña)`}
              >
                Ver demo
              </a>
            )
          }
          <a
            class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant border-b border-on-surface-variant pb-1 hover:text-primary hover:border-primary transition-colors"
            href={data.repositorioUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver repositorio de ${data.titulo} (se abre en nueva pestaña)`}
          >
            Repositorio
          </a>
        </div>
        <div
          class="codigo-bloque detalle-reveal"
          style="--detalle-reveal-delay: 600ms"
          aria-hidden="true"
        >
          <pre
            class="font-caption text-caption-xs md:text-caption-md lg:text-caption-lg text-on-surface-variant">
            <code>
              {(data.codigo ?? []).map((linea) => (
                <span class="linea-typing" data-texto={linea} />
              ))}
            </code>
          </pre>
        </div>
      </div>
    </div>
  </div>

  <div
    class="detalle-cuerpo px-margin-xs sm:px-margin-sm md:px-margin-md lg:px-margin-lg xl:px-margin-xl"
  >
    <div
      class="max-w-container-max mx-auto py-section-y-sm sm:py-section-y-md grid grid-cols-1 md:grid-cols-12 gap-gutter-md lg:gap-gutter-xl"
    >
      <div class="md:col-span-8 detalle-contenido">
        <Content />
      </div>
      <aside
        class="hidden md:block md:col-span-4"
        aria-label="Esquema del documento"
        data-sidebar
      >
        <div class="sticky top-32 space-y-6">
          <p
            class="font-label-base text-label-base-xs md:text-label-base-md lg:text-label-base-lg uppercase text-on-surface-variant"
          >
            Secciones
          </p>
          <nav>
            <ul class="space-y-4 border-l border-outline-variant pl-5">
              {
                headings
                  .filter(h => h.depth === 2)
                  .map(heading => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="font-body-base text-body-base-xs md:text-body-base-md lg:text-body-base-lg text-on-surface-variant hover:text-primary transition-colors block"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))
              }
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</article>

<script>
  import { inicializarVolverDetalle } from '@/scripts/volver-detalle';
  import { inicializarRevelarDetalle } from '@/scripts/revelar-detalle';
  import { inicializarTypingCodigo } from '@/scripts/typing-codigo';
  import { inicializarNavegacionSidebar } from '@/scripts/navegacion-sidebar';
  import '@/scripts/restauracion-scroll';
  inicializarVolverDetalle();
  document.addEventListener('astro:page-load', inicializarVolverDetalle);
  inicializarRevelarDetalle();
  document.addEventListener('astro:page-load', inicializarRevelarDetalle);
  inicializarTypingCodigo();
  document.addEventListener('astro:page-load', inicializarTypingCodigo);
  inicializarNavegacionSidebar();
  document.addEventListener('astro:page-load', inicializarNavegacionSidebar);
</script>
